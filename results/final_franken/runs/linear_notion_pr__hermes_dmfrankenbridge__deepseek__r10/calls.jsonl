{"t": 1794115475.3922513, "kind": "call", "tool": "github_push_files", "args": {"branch": "eng-91", "files": [{"content": "MIGRATION_URL = \"https://developer.acme.example/migrate\"\n\n\ndef deprecation_headers(sunset_date: str) -> dict:\n    \"\"\"Build the response headers for a deprecated (v1) endpoint.\n\n    ``sunset_date`` must be an HTTP-date, e.g.\n    ``\"Wed, 11 Nov 2026 23:59:59 GMT\"``.\n    \"\"\"\n    return {\n        \"Deprecation\": \"true\",\n        \"Sunset\": sunset_date,\n        \"Link\": f'<{MIGRATION_URL}>; rel=\"deprecation\"',\n    }\n", "path": "api/headers.py"}], "message": "feat(api): add deprecation headers helper\n\nImplement api.headers.deprecation_headers(sunset_date) with the headers\nfrom the API guidelines (Deprecation, Sunset, Link rel=\"deprecation\").\n\nRefs: ENG-91", "owner": "acme", "repo": "public-api"}, "ok": true}
