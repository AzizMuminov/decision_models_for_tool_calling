{"t": 1794108624.4719534, "kind": "call", "tool": "github_create_or_update_file", "args": {"branch": "eng-91", "content": "def deprecation_headers(sunset_date: str) -> dict:\n    \"\"\"Return the deprecation headers for a deprecated v1 endpoint.\n\n    Per the API guidelines (Notion, \"API guidelines\" > Deprecation):\n    Deprecation: true\n    Sunset: <HTTP-date>\n    Link: <https://developer.acme.example/migrate>; rel=\"deprecation\"\n    \"\"\"\n    return {\n        \"Deprecation\": \"true\",\n        \"Sunset\": sunset_date,\n        \"Link\": '<https://developer.acme.example/migrate>; rel=\"deprecation\"',\n    }\n", "message": "ENG-91: add deprecation headers to v1 endpoints", "owner": "acme", "path": "api/headers.py", "repo": "public-api"}, "ok": true}
{"t": 1794108627.1392903, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements `api.headers.deprecation_headers(sunset_date)` for the v1 endpoints, per ENG-91.\n\nHeaders follow the Deprecation section of the Notion \"API guidelines\" page:\n\n- `Deprecation: true`\n- `Sunset: <HTTP-date>` (the `sunset_date` argument)\n- `Link: <https://developer.acme.example/migrate>; rel=\"deprecation\"`\n\nLinear: ENG-91", "head": "eng-91", "owner": "acme", "repo": "public-api", "title": "ENG-91: Add deprecation headers to v1 endpoints"}, "ok": true}
