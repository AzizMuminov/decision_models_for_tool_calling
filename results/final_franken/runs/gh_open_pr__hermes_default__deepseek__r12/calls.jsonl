{"t": 1794117745.840953, "kind": "call", "tool": "github_push_files", "args": {"branch": "fix/pagination-57", "files": [{"content": "def page(items: list, number: int, size: int) -> list:\n    \"\"\"Return a slice of ``items`` for the given 1-based page ``number``.\"\"\"\n    start = (number - 1) * size\n    return items[start:start + size]\n", "path": "catalog/pager.py"}], "message": "Fix pagination offset: page numbers are 1-based\n\ncatalog.pager.page() computed start = number * size, so page 1\nreturned the second page. Compute start from a 1-based page number\ninstead.\n\nFixes #57", "owner": "acme", "repo": "catalog"}, "ok": true}
