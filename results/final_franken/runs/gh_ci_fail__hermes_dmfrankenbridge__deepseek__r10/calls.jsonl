{"t": 1794115454.5574799, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n_CENT = Decimal(\"0.01\")\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\n\n    Card-network contract (PAY-88): fees are computed on exact decimal values\n    and rounded HALF-UP to cents (2.675 -> 2.68, 1.005 -> 1.01). Binary float\n    rounding is not acceptable, so the amount is converted through its decimal\n    string representation before quantizing.\n    \"\"\"\n    return float(Decimal(str(amount)).quantize(_CENT, rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Fix fee rounding: use exact decimal arithmetic with ROUND_HALF_UP", "owner": "acme", "repo": "payments"}, "ok": true}
