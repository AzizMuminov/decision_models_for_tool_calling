{"t": 1794109152.1775763, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\n\n    PAY-88 (card-network contract): fees must be computed on exact decimal\n    values and rounded HALF-UP to cents, so binary floats are converted via\n    their decimal string representation before rounding.\n    \"\"\"\n    amount_dec = Decimal(str(amount))\n    fee_dec = amount_dec * Decimal(\"0.01\") * 100\n    return float(fee_dec.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Fix fee rounding to satisfy PAY-88 contract\n\nCompute fees on exact decimal values and round HALF-UP to cents instead of\nrelying on binary float rounding, which turned 2.675 into 2.67.\n\nFixes the failing contract-tests check on #214.", "owner": "acme", "repo": "payments"}, "ok": true}
