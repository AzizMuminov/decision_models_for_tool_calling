{"t": 1794111573.5728846, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n_CENT = Decimal(\"0.01\")\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents (half-up).\"\"\"\n    exact = Decimal(str(amount)) * Decimal(\"0.01\") * 100\n    return float(exact.quantize(_CENT, rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Round fees half-up on exact decimal values (PAY-88)\n\nComputing the fee in binary floating point makes 2.675 round down to\n2.67, violating the card-network contract. Parse the amount as a\nDecimal and quantize to cents with ROUND_HALF_UP so ties round up.", "owner": "acme", "repo": "payments"}, "ok": true}
