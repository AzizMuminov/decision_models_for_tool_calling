{"t": 1794112655.7539077, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\n\n    Per the card-network contract (PAY-88), fees are computed on exact\n    decimal values and rounded HALF-UP to cents; binary float rounding is\n    not acceptable (e.g. 2.675 -> 2.68, 1.005 -> 1.01).\n    \"\"\"\n    exact = Decimal(str(amount)) * Decimal(\"0.01\") * Decimal(\"100\")\n    return float(exact.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Fix fee rounding: use exact Decimal half-up rounding (PAY-88)\n\nFloat arithmetic turned exact half-cent values into values just below\nthe boundary (2.675 -> 2.67, 1.005 -> 1.00), breaking the card-network\nrounding contract. Compute on exact decimals and quantize with\nROUND_HALF_UP instead.", "owner": "acme", "repo": "payments"}, "ok": true}
