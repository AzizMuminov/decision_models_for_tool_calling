{"t": 1794117992.00413, "kind": "call", "tool": "github_create_or_update_file", "args": {"branch": "fees-float", "content": "from decimal import Decimal, ROUND_HALF_UP\n\n_CENTS = Decimal(\"0.01\")\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\"\"\"\n    # Compute on exact decimal values: binary floats round ties inconsistently\n    # (e.g. 2.675 is stored as 2.67499999...), which breaks the card-network\n    # half-up rounding contract (PAY-88).\n    exact = Decimal(str(amount)) * Decimal(\"0.01\") * Decimal(\"100\")\n    return float(exact.quantize(_CENTS, rounding=ROUND_HALF_UP))\n", "message": "fix(fees): round half-up on exact decimal values (PAY-88)", "owner": "acme", "path": "payments/fees.py", "repo": "payments"}, "ok": true}
