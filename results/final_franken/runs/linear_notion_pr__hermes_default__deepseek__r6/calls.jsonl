{"t": 1794111241.513021, "kind": "call", "tool": "github_create_or_update_file", "args": {"branch": "eng-91", "content": "def deprecation_headers(sunset_date: str) -> dict:\n    \"\"\"Return the HTTP headers that mark an endpoint as deprecated.\n\n    ``sunset_date`` must be an HTTP-date (RFC 7231), e.g.\n    ``\"Wed, 11 Nov 2026 23:59:59 GMT\"``.\n    \"\"\"\n    return {\n        \"Deprecation\": \"true\",\n        \"Sunset\": sunset_date,\n        \"Link\": '<https://developer.acme.example/migrate>; rel=\"deprecation\"',\n    }\n", "message": "ENG-91: add deprecation headers to v1 endpoints", "owner": "acme", "path": "api/headers.py", "repo": "public-api"}, "ok": true}
{"t": 1794111244.4318354, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements `api.headers.deprecation_headers(sunset_date)` for v1 endpoints, following the API guidelines (Deprecation section):\n\n- `Deprecation: true`\n- `Sunset: <HTTP-date>` (the `sunset_date` argument)\n- `Link: <https://developer.acme.example/migrate>; rel=\"deprecation\"`\n\nCloses ENG-91.", "head": "eng-91", "owner": "acme", "repo": "public-api", "title": "ENG-91: Add deprecation headers to v1 endpoints"}, "ok": true}
