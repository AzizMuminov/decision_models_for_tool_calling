{"t": 1794114918.7084188, "kind": "call", "tool": "github_push_files", "args": {"branch": "eng-91", "files": [{"content": "\"\"\"HTTP header helpers for the public API.\"\"\"\n\nDEPRECATION_LINK = '<https://developer.acme.example/migrate>; rel=\"deprecation\"'\n\n\ndef deprecation_headers(sunset_date: str) -> dict:\n    \"\"\"Return the headers that mark an endpoint as deprecated.\n\n    See the \"API guidelines\" page (section Deprecation): deprecated\n    endpoints return ``Deprecation``, ``Sunset`` and ``Link`` headers.\n    \"\"\"\n    return {\n        \"Deprecation\": \"true\",\n        \"Sunset\": sunset_date,\n        \"Link\": DEPRECATION_LINK,\n    }\n", "path": "api/headers.py"}], "message": "ENG-91: add deprecation headers helper", "owner": "acme", "repo": "public-api"}, "ok": true}
{"t": 1794114920.712101, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements `api.headers.deprecation_headers(sunset_date)` as described in ENG-91.\n\nFollows the \"API guidelines\" page in Notion, section Deprecation: deprecated endpoints return\n\n- `Deprecation: true`\n- `Sunset: <HTTP-date>` (the sunset date passed in)\n- `Link: <https://developer.acme.example/migrate>; rel=\"deprecation\"`\n\nLinear: ENG-91", "head": "eng-91", "owner": "acme", "repo": "public-api", "title": "ENG-91: Add deprecation headers to v1 endpoints"}, "ok": true}
