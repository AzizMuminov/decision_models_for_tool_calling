{"t": 1794119025.9690862, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import ROUND_HALF_UP, Decimal\n\n_CENT = Decimal(\"0.01\")\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\n\n    Computed on exact decimal values and rounded HALF-UP, per the\n    card-network contract (PAY-88). Binary float rounding is not acceptable:\n    e.g. round(2.675, 2) == 2.67 because 2.675 is stored as 2.67499...,\n    whereas the contract requires 2.68.\n    \"\"\"\n    exact = Decimal(repr(amount)) * Decimal(\"0.01\") * Decimal(\"100\")\n    return float(exact.quantize(_CENT, rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Fix fee rounding: use exact decimal arithmetic with ROUND_HALF_UP (PAY-88)\n\nround() on binary floats rounded 2.675 down to 2.67 because 2.675 is\nstored as 2.67499999..., breaking the card-network half-up rounding\ncontract. Compute on Decimal values and quantize HALF_UP to cents.", "owner": "acme", "repo": "payments"}, "ok": true}
