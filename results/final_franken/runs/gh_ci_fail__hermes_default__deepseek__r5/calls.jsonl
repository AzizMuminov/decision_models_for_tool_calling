{"t": 1794110332.4960127, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\n\n    Computed on the exact decimal value of ``amount`` and rounded HALF-UP\n    (card-network contract, PAY-88). Binary float arithmetic is not used,\n    because it can round a value like 2.675 down to 2.67.\n    \"\"\"\n    exact = Decimal(str(amount)) * Decimal(\"0.01\") * 100\n    return float(exact.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Fix fee rounding: compute on exact decimals with ROUND_HALF_UP (PAY-88)", "owner": "acme", "repo": "payments"}, "ok": true}
