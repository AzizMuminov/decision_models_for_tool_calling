{"t": 1794108043.0040953, "kind": "call", "tool": "github_push_files", "args": {"branch": "PAY-412-mask-iban", "files": [{"content": "\"\"\"Helpers for masking sensitive payment data before it is logged.\"\"\"\n\n__all__ = [\"mask_iban\"]\n\n\ndef mask_iban(iban: str) -> str:\n    \"\"\"Return a log-safe representation of an IBAN.\n\n    Spaces are removed, the two-letter country code and the last four\n    characters are kept, and every character in between is replaced by\n    ``*`` so the result has the same length as the space-free input.\n\n    >>> mask_iban(\"DE89 3704 0044 0532 0130 00\")\n    'DE****************3000'\n    \"\"\"\n    compact = \"\".join(iban.split())\n    if len(compact) < 6:\n        # Not long enough to keep both the country code and the last four\n        # characters; keep the country code and mask whatever follows it.\n        return compact[:2] + \"*\" * max(len(compact) - 2, 0)\n    return compact[:2] + \"*\" * (len(compact) - 6) + compact[-4:]\n", "path": "payments/masking.py"}, {"content": "import pytest\n\nfrom payments.masking import mask_iban\n\n\ndef test_masks_middle_and_keeps_country_code_and_last_four():\n    assert mask_iban(\"DE89370400440532013000\") == \"DE****************3000\"\n\n\ndef test_removes_spaces():\n    assert mask_iban(\"DE89 3704 0044 0532 0130 00\") == \"DE****************3000\"\n\n\ndef test_preserves_length_of_compact_input():\n    iban = \"GB33BUKB20201555555555\"\n    masked = mask_iban(iban)\n    assert len(masked) == len(iban)\n    assert masked.startswith(\"GB\")\n    assert masked.endswith(\"5555\")\n    assert set(masked[2:-4]) == {\"*\"}\n\n\ndef test_empty_string():\n    assert mask_iban(\"\") == \"\"\n\n\ndef test_short_input_keeps_country_code_only():\n    assert mask_iban(\"DE12\") == \"DE**\"\n    assert mask_iban(\"DE\") == \"DE\"\n\n\ndef test_six_characters_keeps_everything():\n    assert mask_iban(\"DE1234\") == \"DE1234\"\n\n\n@pytest.mark.parametrize(\n    \"iban\",\n    [\n        \"DE89370400440532013000\",\n        \"GB33BUKB20201555555555\",\n        \"FR1420041010050500013M02606\",\n    ],\n)\ndef test_no_characters_of_the_middle_are_leaked(iban):\n    masked = mask_iban(iban)\n    assert masked[2:-4] == \"*\" * (len(iban) - 6)\n", "path": "tests/test_masking.py"}], "message": "PAY-412: keep last four characters for six-character input", "owner": "acme", "repo": "payments"}, "ok": true}
