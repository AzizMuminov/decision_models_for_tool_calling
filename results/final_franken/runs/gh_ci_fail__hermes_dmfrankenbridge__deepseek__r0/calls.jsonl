{"t": 1794105023.2620735, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\nCENT = Decimal(\"0.01\")\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded half-up to cents.\n\n    The fee is computed on exact decimal values (never binary floats) and\n    rounded HALF-UP to cents, as required by the card-network contract\n    (PAY-88): 2.675 -> 2.68, 1.005 -> 1.01.\n    \"\"\"\n    exact = Decimal(str(amount)) * Decimal(\"0.01\") * 100\n    return float(exact.quantize(CENT, rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}, {"content": "from payments.fees import fee\n\ndef test_fee_basic():\n    assert fee(100.0) == 100.0\n\ndef test_fee_rounding_contract():\n    # Card-network contract (PAY-88): half-up on exact decimal values.\n    assert fee(2.675) == 2.68\n    assert fee(1.005) == 1.01\n", "path": "tests/test_fees.py"}], "message": "Fix contract-tests: round fees half-up on exact decimals (PAY-88)\n\nfee() used binary float arithmetic (round(amount * 0.01 * 100, 2)), which\nrounds 2.675 down to 2.67 and 1.005 to 1.00. The card-network contract\nrequires HALF-UP rounding on exact decimal values, so compute with\nDecimal and quantize with ROUND_HALF_UP. Adds a regression test.", "owner": "acme", "repo": "payments"}, "ok": true}
