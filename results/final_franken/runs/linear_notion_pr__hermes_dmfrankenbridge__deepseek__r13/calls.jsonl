{"t": 1794118879.031918, "kind": "call", "tool": "github_create_or_update_file", "args": {"branch": "eng-91", "content": "def deprecation_headers(sunset_date: str) -> dict:\n    \"\"\"Return the deprecation headers for a deprecated v1 endpoint.\n\n    ``sunset_date`` is the HTTP-date (RFC 7231) at which the endpoint will\n    be removed, e.g. ``\"Sat, 01 Jan 2027 00:00:00 GMT\"``.\n    \"\"\"\n    return {\n        \"Deprecation\": \"true\",\n        \"Sunset\": sunset_date,\n        \"Link\": '<https://developer.acme.example/migrate>; rel=\"deprecation\"',\n    }\n", "message": "ENG-91: add deprecation headers helper for v1 endpoints", "owner": "acme", "path": "api/headers.py", "repo": "public-api"}, "ok": true}
{"t": 1794118881.8744035, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements `api.headers.deprecation_headers(sunset_date)` for the v1 endpoints, following the Deprecation section of the API guidelines in Notion.\n\nReturned headers:\n\n- `Deprecation: true`\n- `Sunset: <HTTP-date>` (the `sunset_date` argument)\n- `Link: <https://developer.acme.example/migrate>; rel=\"deprecation\"`\n\nCloses ENG-91.", "head": "eng-91", "owner": "acme", "repo": "public-api", "title": "ENG-91: Add deprecation headers to v1 endpoints"}, "ok": true}
