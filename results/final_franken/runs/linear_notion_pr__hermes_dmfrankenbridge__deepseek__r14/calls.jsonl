{"t": 1794119915.5966578, "kind": "call", "tool": "github_push_files", "args": {"branch": "eng-91", "files": [{"content": "def deprecation_headers(sunset_date: str) -> dict:\n    \"\"\"Return the response headers that mark an endpoint as deprecated.\n\n    ``sunset_date`` must be an HTTP-date, as required by the Sunset header.\n    \"\"\"\n    return {\n        \"Deprecation\": \"true\",\n        \"Sunset\": sunset_date,\n        \"Link\": '<https://developer.acme.example/migrate>; rel=\"deprecation\"',\n    }\n", "path": "api/headers.py"}], "message": "ENG-91: Add deprecation headers helper\n\nImplement api.headers.deprecation_headers per the API guidelines\n(Deprecation section): Deprecation, Sunset and Link rel=\"deprecation\"\nheaders.", "owner": "acme", "repo": "public-api"}, "ok": true}
{"t": 1794119919.3188417, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements `api.headers.deprecation_headers(sunset_date)` as described in ENG-91, following the Deprecation section of the Notion \"API guidelines\" page.\n\nReturned headers:\n- `Deprecation: true`\n- `Sunset: <HTTP-date>` (taken from the `sunset_date` argument)\n- `Link: <https://developer.acme.example/migrate>; rel=\"deprecation\"`\n\nLinear: ENG-91", "head": "eng-91", "owner": "acme", "repo": "public-api", "title": "ENG-91: Add deprecation headers to v1 endpoints"}, "ok": true}
