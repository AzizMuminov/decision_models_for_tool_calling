{"t": 1794115486.9762306, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded to cents.\n\n    Per the card-network contract (PAY-88) the fee is computed on exact\n    decimal values and rounded HALF-UP to cents, e.g. 2.675 -> 2.68.\n    \"\"\"\n    cents = Decimal(str(amount)) * Decimal(\"0.01\") * Decimal(\"100\")\n    return float(cents.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}], "message": "Fix fee rounding: compute on exact decimals with ROUND_HALF_UP (PAY-88)", "owner": "acme", "repo": "payments"}, "ok": true}
