{"t": 1794112212.3629773, "kind": "call", "tool": "github_push_files", "args": {"branch": "entry-helper", "files": [{"content": "def make_entry(account: str, amount_cents: int) -> dict:\n    \"\"\"Build a ledger entry for ``account``.\n\n    ``amount_cents`` is a whole number of cents and must be non-negative.\n    Refunds are represented by a separate entry type, not by a negative\n    amount here.\n    \"\"\"\n    if amount_cents < 0:\n        raise ValueError(f\"amount_cents must be non-negative, got {amount_cents}\")\n    return {\"account\": account, \"amount_cents\": amount_cents}\n", "path": "ledger/entries.py"}], "message": "Address review feedback on make_entry\n\n- Rename `amt` to `amount_cents` so the unit is in the name\n- Raise ValueError for negative amounts; refunds use a separate entry type", "owner": "acme", "repo": "ledger"}, "ok": true}
