{"t": 1794109115.3801563, "kind": "call", "tool": "github_create_or_update_file", "args": {"branch": "fees-float", "content": "from decimal import Decimal, ROUND_HALF_UP\n\n_CENTS = Decimal(\"0.01\")\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Processing fee: 1% of the amount, rounded half-up to cents.\n\n    Card-network contract PAY-88 requires fees to be computed on exact\n    decimal values and rounded HALF-UP, so the rounding is done with\n    ``Decimal`` rather than binary floats.\n    \"\"\"\n    exact = Decimal(str(amount)) * Decimal(\"0.01\") * Decimal(\"100\")\n    return float(exact.quantize(_CENTS, rounding=ROUND_HALF_UP))\n", "message": "Fix fee rounding: use exact decimal HALF-UP per card-network contract (PAY-88)", "owner": "acme", "path": "payments/fees.py", "repo": "payments"}, "ok": true}
