{"t": 1794122851.1460233, "kind": "call", "tool": "github_push_files", "args": {"branch": "pay-412-mask-ibans", "files": [{"path": "payments/masking.py", "content": "def mask_iban(iban: str) -> str:\n    \"\"\"Remove spaces and mask all but the country code and final four characters.\"\"\"\n    compact = iban.replace(\" \", \"\")\n    return \"\".join(\n        \"*\" if 2 <= index < len(compact) - 4 else character\n        for index, character in enumerate(compact)\n    )\n"}, {"path": "tests/test_masking.py", "content": "import pytest\n\nfrom payments.masking import mask_iban\n\n\n@pytest.mark.parametrize(\n    (\"iban\", \"expected\"),\n    [\n        (\"GB82 WEST 1234 5698 7654 32\", \"GB****************5432\"),\n        (\"DE89370400440532013000\", \"DE****************3000\"),\n        (\"FR14 2004 1010 0505 0001 3M02 606\", \"FR*********************2606\"),\n        (\"  GB82  WEST 1234 5698 7654 32  \", \"GB****************5432\"),\n    ],\n)\ndef test_mask_iban(iban, expected):\n    assert mask_iban(iban) == expected\n\n\ndef test_mask_iban_preserves_only_country_and_suffix():\n    iban = \"NL91 ABNA 0417 1643 00\"\n    compact = iban.replace(\" \", \"\")\n    masked = mask_iban(iban)\n\n    assert len(masked) == len(compact)\n    assert masked[:2] == compact[:2]\n    assert masked[-4:] == compact[-4:]\n    assert set(masked[2:-4]) == {\"*\"}\n    assert mask_iban(masked) == masked\n"}], "message": "PAY-412: mask IBANs while preserving country code and final four characters", "owner": "acme", "repo": "payments"}, "ok": true}
{"t": 1794122854.9881127, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements PAY-412 acceptance criteria in payments.masking.mask_iban:\n- Remove spaces.\n- Preserve the two-letter country code and last four characters.\n- Replace every intervening character with '*'.\n\nAdds tests for spaced and unspaced IBANs, multiple countries, repeated/outer spaces, preserved length, masking coverage, and idempotence.\n\nVerification: python -m pytest -q \u2014 5 passed locally.\n\nHosted source reads returned empty results; implementation is based on the supplied local source and Jira acceptance criteria.", "draft": false, "head": "pay-412-mask-ibans", "owner": "acme", "repo": "payments", "title": "PAY-412: Mask IBANs in logs"}, "ok": true}
