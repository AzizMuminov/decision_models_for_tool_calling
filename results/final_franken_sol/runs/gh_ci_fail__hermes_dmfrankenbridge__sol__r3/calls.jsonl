{"t": 1794124187.2631853, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "owner": "acme", "repo": "payments", "message": "Fix fee rounding to honor PAY-88 decimal HALF_UP contract", "files": [{"path": "payments/fees.py", "content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Round the fee to cents using PAY-88's exact-decimal HALF_UP contract.\"\"\"\n    return float(Decimal(str(amount)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n"}, {"path": "tests/test_fees.py", "content": "from payments.fees import fee\n\n\ndef test_fee_basic():\n    assert fee(100.0) == 100.0\n\n\ndef test_fee_rounding_contract():\n    assert fee(2.675) == 2.68\n    assert fee(1.005) == 1.01\n\n\ndef test_fee_half_up_not_half_even():\n    assert fee(2.685) == 2.69\n    assert fee(-2.675) == -2.68\n\n\ndef test_fee_rounding_preserves_float_api():\n    assert isinstance(fee(2.675), float)\n"}]}, "ok": true}
