{"t": 1794123328.6474242, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Round the fee amount to cents using PAY-88 decimal half-up rounding.\"\"\"\n    return float(Decimal(str(amount)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}, {"content": "import pytest\n\nfrom payments.fees import fee\n\n\ndef test_fee_basic():\n    assert fee(100.0) == 100.0\n\n\n@pytest.mark.parametrize(\n    (\"amount\", \"expected\"),\n    [\n        (2.675, 2.68),\n        (1.005, 1.01),\n        (2.665, 2.67),\n        (-2.675, -2.68),\n        (2.674, 2.67),\n        (2.676, 2.68),\n        (0.0, 0.0),\n    ],\n)\ndef test_fee_decimal_half_up(amount, expected):\n    assert fee(amount) == expected\n    assert isinstance(fee(amount), float)\n", "path": "tests/test_fees.py"}], "message": "Fix fee rounding to honor PAY-88 decimal half-up contract", "owner": "acme", "repo": "payments"}, "ok": true}
