{"t": 1794124668.3257616, "kind": "call", "tool": "github_push_files", "args": {"branch": "pay-412-mask-ibans", "files": [{"content": "def mask_iban(iban: str) -> str:\n    \"\"\"Remove spaces and mask all but the country code and final four characters.\"\"\"\n    compact = iban.replace(\" \", \"\")\n    return \"\".join(\n        char if index < 2 or index >= len(compact) - 4 else \"*\"\n        for index, char in enumerate(compact)\n    )\n", "path": "payments/masking.py"}, {"content": "import pytest\n\nfrom payments.masking import mask_iban\n\n\n@pytest.mark.parametrize(\n    (\"iban\", \"expected\"),\n    [\n        (\"GB82 WEST 1234 5698 7654 32\", \"GB****************5432\"),\n        (\"DE89370400440532013000\", \"DE****************3000\"),\n        (\"FR14 2004 1010 0505 0001 3M02 606\", \"FR*********************2606\"),\n        (\"  GB82  WEST 1234 5698 7654 32  \", \"GB****************5432\"),\n        (\"GB12AB\", \"GB12AB\"),\n        (\"\", \"\"),\n        (\"   \", \"\"),\n        (\"G\", \"G\"),\n        (\"GB123\", \"GB123\"),\n        (\"GB12345\", \"GB*2345\"),\n    ],\n)\ndef test_mask_iban(iban, expected):\n    assert mask_iban(iban) == expected\n\n\n@pytest.mark.parametrize(\"length\", range(15, 35))\ndef test_mask_iban_preserves_only_country_and_suffix(length):\n    iban = \"GB\" + \"1\" * (length - 6) + \"2345\"\n    masked = mask_iban(\" \".join(iban))\n    assert len(masked) == len(iban)\n    assert masked[:2] == \"GB\"\n    assert masked[-4:] == \"2345\"\n    assert set(masked[2:-4]) == {\"*\"}\n", "path": "tests/test_masking.py"}], "message": "PAY-412: mask IBANs while preserving country code and last four characters", "owner": "acme", "repo": "payments"}, "ok": true}
{"t": 1794124671.8520694, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements PAY-412 acceptance criteria in payments.masking.mask_iban:\n- Remove spaces.\n- Preserve the two-letter country code and final four characters.\n- Replace all intervening characters with '*'.\n\nAdds parametrized tests for examples, spacing, short/empty inputs, and IBAN lengths 15\u201334.\n\nValidation: python -m pytest -q \u2014 30 passed in 0.02s.\n\nNote: GitHub content lookups returned empty listings; implementation was based on the supplied local source and Jira acceptance criteria.", "draft": false, "head": "pay-412-mask-ibans", "owner": "acme", "repo": "payments", "title": "PAY-412: Mask IBANs in logs"}, "ok": true}
