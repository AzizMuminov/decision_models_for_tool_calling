{"t": 1794122951.5223715, "kind": "call", "tool": "github_push_files", "args": {"branch": "fees-float", "files": [{"content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Return the fee rounded to cents using PAY-88's decimal HALF-UP rule.\"\"\"\n    return float(Decimal(str(amount)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n", "path": "payments/fees.py"}, {"content": "from payments.fees import fee\n\n\ndef test_fee_basic():\n    assert fee(100.0) == 100.0\n\n\ndef test_fee_rounding_contract():\n    # PAY-88: exact decimal values, rounded HALF-UP to cents.\n    assert fee(2.675) == 2.68\n    assert fee(1.005) == 1.01\n", "path": "tests/test_fees.py"}], "message": "Fix fee rounding to honor PAY-88 decimal HALF-UP contract", "owner": "acme", "repo": "payments"}, "ok": true}
