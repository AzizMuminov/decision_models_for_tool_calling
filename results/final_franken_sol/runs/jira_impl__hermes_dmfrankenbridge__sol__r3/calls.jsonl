{"t": 1794124358.690738, "kind": "call", "tool": "github_push_files", "args": {"branch": "pay-412-mask-ibans", "files": [{"path": "payments/masking.py", "content": "def mask_iban(iban: str) -> str:\n    \"\"\"Remove spaces and mask all but the country code and last four characters.\"\"\"\n    compact = iban.replace(\" \", \"\")\n    return \"\".join(\n        char if index < 2 or index >= len(compact) - 4 else \"*\"\n        for index, char in enumerate(compact)\n    )\n"}, {"path": "tests/test_masking.py", "content": "import pytest\n\nfrom payments.masking import mask_iban\n\n\n@pytest.mark.parametrize(\n    (\"iban\", \"expected\"),\n    [\n        (\"GB82 WEST 1234 5698 7654 32\", \"GB****************5432\"),\n        (\"DE89370400440532013000\", \"DE****************3000\"),\n        (\"FR14 2004 1010 0505 0001 3M02 606\", \"FR*********************2606\"),\n        (\"  GB82  WEST 1234 5698 7654 32  \", \"GB****************5432\"),\n        (\"GB82WEST12345698765432\", \"GB****************5432\"),\n    ],\n)\ndef test_mask_iban(iban, expected):\n    assert mask_iban(iban) == expected\n"}], "message": "PAY-412: mask IBANs while retaining country code and final four characters", "owner": "acme", "repo": "payments"}, "ok": true}
{"t": 1794124362.2143445, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements PAY-412 acceptance criteria in payments.masking.mask_iban: remove spaces, preserve the two-letter country code and final four characters, and replace all intervening characters with '*'.\n\nAdds five regression cases covering GB, DE and FR IBANs, spaced and unspaced inputs, and surrounding/repeated spaces.\n\nLocal verification: python -m pytest -q \u2014 5 passed. No tests were present in the supplied workspace before this change.", "draft": false, "head": "pay-412-mask-ibans", "owner": "acme", "repo": "payments", "title": "PAY-412: Mask IBANs in logs"}, "ok": true}
