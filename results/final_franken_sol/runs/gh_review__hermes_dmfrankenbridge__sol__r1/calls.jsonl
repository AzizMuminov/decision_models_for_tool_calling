{"t": 1794123283.2987702, "kind": "call", "tool": "github_push_files", "args": {"branch": "entry-helper", "files": [{"content": "def make_entry(account: str, amount_cents: int) -> dict:\n    if amount_cents < 0:\n        raise ValueError(\"amount_cents must be non-negative\")\n    return {\"account\": account, \"amount_cents\": amount_cents}\n", "path": "ledger/entries.py"}, {"content": "import pytest\n\nfrom ledger.entries import make_entry\n\n\n@pytest.mark.parametrize(\"amount_cents\", [0, 1, 1250])\ndef test_make_entry_accepts_non_negative_amounts(amount_cents):\n    assert make_entry(account=\"cash\", amount_cents=amount_cents) == {\n        \"account\": \"cash\",\n        \"amount_cents\": amount_cents,\n    }\n\n\ndef test_make_entry_accepts_positional_amount():\n    assert make_entry(\"cash\", 100) == {\"account\": \"cash\", \"amount_cents\": 100}\n\n\n@pytest.mark.parametrize(\"amount_cents\", [-1, -1250])\ndef test_make_entry_rejects_negative_amounts(amount_cents):\n    with pytest.raises(ValueError, match=\"amount_cents must be non-negative\"):\n        make_entry(\"cash\", amount_cents)\n", "path": "tests/test_entries.py"}], "message": "Address review: name amount units and reject negative entries", "owner": "acme", "repo": "ledger"}, "ok": true}
