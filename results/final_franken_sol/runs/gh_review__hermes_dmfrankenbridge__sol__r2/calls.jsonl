{"t": 1794123873.0512922, "kind": "call", "tool": "github_push_files", "args": {"branch": "entry-helper", "files": [{"path": "ledger/entries.py", "content": "def make_entry(account: str, amount_cents: int) -> dict:\n    if amount_cents < 0:\n        raise ValueError(\"amount_cents must be non-negative\")\n    return {\"account\": account, \"amount_cents\": amount_cents}\n"}, {"path": "tests/test_entries.py", "content": "import pytest\n\nfrom ledger.entries import make_entry\n\n\n@pytest.mark.parametrize(\"amount_cents\", [0, 1, 12345])\ndef test_make_entry_accepts_non_negative_amounts(amount_cents):\n    assert make_entry(account=\"cash\", amount_cents=amount_cents) == {\n        \"account\": \"cash\",\n        \"amount_cents\": amount_cents,\n    }\n\n\n@pytest.mark.parametrize(\"amount_cents\", [-1, -12345])\ndef test_make_entry_rejects_negative_amounts(amount_cents):\n    with pytest.raises(ValueError, match=\"amount_cents must be non-negative\"):\n        make_entry(account=\"cash\", amount_cents=amount_cents)\n\n\ndef test_make_entry_supports_positional_arguments():\n    assert make_entry(\"cash\", 25) == {\"account\": \"cash\", \"amount_cents\": 25}\n"}], "message": "Address review: name amount units and reject negative entries", "owner": "acme", "repo": "ledger"}, "ok": true}
