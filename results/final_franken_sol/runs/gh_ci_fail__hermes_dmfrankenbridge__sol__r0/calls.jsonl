{"t": 1794122950.5160246, "kind": "call", "tool": "github_push_files", "args": {"owner": "acme", "repo": "payments", "branch": "fees-float", "message": "Fix fee rounding to honor PAY-88 decimal half-up contract", "files": [{"path": "payments/fees.py", "content": "from decimal import Decimal, ROUND_HALF_UP\n\n\ndef fee(amount: float) -> float:\n    \"\"\"Round the fee amount to cents using the PAY-88 decimal contract.\"\"\"\n    return float(Decimal(str(amount)).quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_UP))\n"}, {"path": "tests/test_fees.py", "content": "from payments.fees import fee\n\n\ndef test_fee_basic():\n    assert fee(100.0) == 100.0\n\n\ndef test_fee_rounding_contract():\n    # PAY-88: round exact decimal values HALF-UP, not binary floats.\n    assert fee(2.675) == 2.68\n    assert fee(1.005) == 1.01\n\n\ndef test_fee_rounding_negative_ties():\n    assert fee(-2.675) == -2.68\n    assert fee(-1.005) == -1.01\n\n\ndef test_fee_rounding_non_ties():\n    assert fee(2.674) == 2.67\n    assert fee(2.676) == 2.68\n    assert fee(0.0) == 0.0\n"}]}, "ok": true}
