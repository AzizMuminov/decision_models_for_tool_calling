{"t": 1794124424.7358165, "kind": "call", "tool": "github_push_files", "args": {"owner": "acme", "repo": "ledger", "branch": "entry-helper", "message": "Address entry helper review: explicit cents and reject negative amounts", "files": [{"path": "ledger/entries.py", "content": "def make_entry(account: str, amount_cents: int) -> dict:\n    if amount_cents < 0:\n        raise ValueError(\"amount_cents must be non-negative\")\n    return {\"account\": account, \"amount_cents\": amount_cents}\n"}, {"path": "tests/test_entries.py", "content": "import pytest\n\nfrom ledger.entries import make_entry\n\n\n@pytest.mark.parametrize(\"amount_cents\", [0, 1, 1250])\ndef test_make_entry_accepts_non_negative_amounts(amount_cents):\n    assert make_entry(account=\"cash\", amount_cents=amount_cents) == {\n        \"account\": \"cash\",\n        \"amount_cents\": amount_cents,\n    }\n\n\n@pytest.mark.parametrize(\"amount_cents\", [-1, -1250])\ndef test_make_entry_rejects_negative_amounts(amount_cents):\n    with pytest.raises(ValueError):\n        make_entry(account=\"cash\", amount_cents=amount_cents)\n\n\ndef test_make_entry_accepts_positional_arguments():\n    assert make_entry(\"cash\", 100) == {\"account\": \"cash\", \"amount_cents\": 100}\n"}]}, "ok": true}
