{"t": 1794123561.039791, "kind": "call", "tool": "github_push_files", "args": {"branch": "pay-412-mask-ibans", "files": [{"path": "payments/masking.py", "content": "def mask_iban(iban: str) -> str:\n    \"\"\"Remove spaces and mask all but the country code and final four characters.\"\"\"\n    compact = iban.replace(\" \", \"\")\n    return \"\".join(\n        \"*\" if 2 <= index < len(compact) - 4 else character\n        for index, character in enumerate(compact)\n    )\n"}, {"path": "tests/test_masking.py", "content": "import pytest\n\nfrom payments.masking import mask_iban\n\n\n@pytest.mark.parametrize(\n    (\"iban\", \"expected\"),\n    [\n        (\"GB82 WEST 1234 5698 7654 32\", \"GB****************5432\"),\n        (\"GB82WEST12345698765432\", \"GB****************5432\"),\n        (\"DE89 3704 0044 0532 0130 00\", \"DE****************3000\"),\n        (\"FR14 2004 1010 0505 0001 3M02 606\", \"FR*********************2606\"),\n        (\"NO93 8601 1117 947\", \"NO*********7947\"),\n        (\"  GB82  WEST 1234 5698 7654 32  \", \"GB****************5432\"),\n    ],\n)\ndef test_mask_iban(iban, expected):\n    assert mask_iban(iban) == expected\n\n\ndef test_mask_iban_preserves_only_country_code_and_last_four():\n    iban = \"GB82WEST12345698765432\"\n    masked = mask_iban(iban)\n\n    assert len(masked) == len(iban)\n    assert masked[:2] == iban[:2]\n    assert masked[-4:] == iban[-4:]\n    assert set(masked[2:-4]) == {\"*\"}\n"}], "message": "PAY-412: mask IBANs while preserving country code and final four characters", "owner": "acme", "repo": "payments"}, "ok": true}
{"t": 1794123564.6235518, "kind": "call", "tool": "github_create_pull_request", "args": {"base": "main", "body": "Implements PAY-412 acceptance criteria in payments.masking.mask_iban:\n- Remove spaces.\n- Preserve the two-letter country code and last four characters.\n- Replace all intervening characters with '*'.\n\nAdds regression tests for spaced/unspaced IBANs, multiple country lengths, repeated/leading/trailing spaces, and preservation/masking invariants.\n\nValidation: python -m pytest -q \u2014 7 passed locally.\n\nRepository reads through the GitHub tools returned empty results; implementation was based on the supplied local repository and Jira acceptance criteria.", "draft": false, "head": "pay-412-mask-ibans", "owner": "acme", "repo": "payments", "title": "PAY-412: Mask IBANs in logs"}, "ok": true}
